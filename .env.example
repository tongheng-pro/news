# Copy to `.env` to change how news is sourced. All optional.
#
# IMPORTANT: the dev server reads these ONCE at startup. After editing this file
# (or to pass a var on the command line) you must restart it:
#     astro dev stop && astro dev --background
# `npm run build` always picks them up (fresh process every time).

# How the data layer sources articles:
#   live  (default) — fetch real news from public APIs, backfill thin
#                     categories from the local mock set
#   mock            — use only the bundled mock dataset, no network at build time
 NEWS_MODE=live

# Include Google News RSS per-topic feeds (Apple / Google / Microsoft / Gaming /
# Mobile / Startups / Cloud / World). Off by default: Google rate-limits
# datacenter IPs and its feed terms target personal readers. "true" to enable.
 NEWS_GOOGLE=true

# How long fetched news stays "fresh" before it's refetched. Applies to any
# long-lived process — the dev server, or an SSR deployment. A stale read is
# served instantly while the refetch happens in the background, and a timer
# refetches on its own even with no traffic. 0 disables the timer.
# For a static deploy this does nothing — freshness = how often you rebuild
# (see "Keeping it fresh" in the README).
 NEWS_TTL_MINUTES=15

# Hacker News and Lobsters items carry no image from their API — without this,
# they'd show a random stock photo. "true" (default) fetches the linked
# article's real og:image/twitter:image as a fallback. "false" disables it
# (faster refresh, no extra requests) and reverts those items to the stock photo.
 NEWS_OG_IMAGES=true
