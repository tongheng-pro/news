---
import Layout from '../layouts/Layout.astro';
import BreakingNews from '../components/BreakingNews.astro';
import FeaturedArticle from '../components/FeaturedArticle.astro';
import NewsCard from '../components/NewsCard.astro';
import TrendingList from '../components/TrendingList.astro';
import CategorySection from '../components/CategorySection.astro';
import Newsletter from '../components/Newsletter.astro';
import {
  getBreakingNews,
  getFeaturedNews,
  getNews,
  getTrendingNews,
  getNewsByCategory,
} from '../lib/news';

const [breaking, featuredList, trending] = await Promise.all([
  getBreakingNews(6),
  getFeaturedNews(4),
  getTrendingNews(6),
]);

const featured = featuredList[0];
const featuredRunnersUp = featuredList.slice(1, 4);

// Latest = newest overall, minus whatever is already shown as the lead.
const latestAll = await getNews(40);
const latest = latestAll.filter((a) => a.slug !== featured?.slug).slice(0, 6);

// Homepage category rails.
const railCategories = [
  'World',
  'AI',
  'Apple',
  'Google',
  'Microsoft',
  'Cybersecurity',
  'Programming',
  'Gaming',
  'Startups',
] as const;

const rails = await Promise.all(
  railCategories.map(async (name) => ({
    name,
    articles: (await getNewsByCategory(name, { pageSize: 4 })).items,
  })),
);
---

<Layout
  title="TechPulse"
  description="Global technology and world news — AI, Apple, Google, Microsoft, cybersecurity, programming, gaming, startups and the headlines shaping the wider world."
  canonical="/"
>
  <BreakingNews articles={breaking} />

  {
    featured && (
      <section class="section">
        <div class="container">
          <p class="eyebrow" style="margin-bottom:16px">Featured story</p>
          <FeaturedArticle article={featured} />
          {featuredRunnersUp.length > 0 && (
            <div class="runners">
              {featuredRunnersUp.map((a) => (
                <NewsCard article={a} variant="compact" />
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container split">
      <div>
        <div class="section-head">
          <h2>Latest news</h2>
          <a href="/trending">All stories →</a>
        </div>
        <div class="latest-list">
          {latest.map((a) => <NewsCard article={a} variant="wide" />)}
        </div>
      </div>
      <aside class="sidebar">
        <TrendingList articles={trending} title="Trending now" />
        <a href="/trending" class="btn" style="width:100%;margin-top:16px">See the full ranking</a>
      </aside>
    </div>
  </section>

  {rails.map((rail) => <CategorySection category={rail.name} articles={rail.articles} columns={4} />)}

  <Newsletter />
</Layout>

<style>
  .runners {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }
  .runners :global(.card--compact) {
    border-bottom: none;
    padding: 0;
  }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: clamp(28px, 5vw, 60px);
    align-items: start;
  }
  .latest-list {
    display: grid;
    gap: 20px;
  }
  .sidebar {
    position: sticky;
    top: calc(var(--header-height) + 20px);
  }
  @media (max-width: 980px) {
    .split {
      grid-template-columns: 1fr;
    }
    .sidebar {
      position: static;
    }
    .runners {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
</style>
