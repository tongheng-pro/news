---
import { CATEGORIES } from '../types/news';

const year = new Date().getFullYear();
const cols = [
  {
    title: 'Editorial Sections',
    links: CATEGORIES.slice(0, 6).map((c) => ({ href: `/category/${c.slug}`, label: c.name })),
  },
  {
    title: 'Exploration',
    links: [
      ...CATEGORIES.slice(6).map((c) => ({ href: `/category/${c.slug}`, label: c.name })),
      { href: '/trending', label: '🔥 Trending Leaderboard' },
    ],
  },
  {
    title: 'Capy Media',
    links: [
      { href: '/search', label: 'Search Archives' },
      { href: '#newsletter', label: 'Daily Dispatch Newsletter' },
      { href: '/rss.xml', label: 'RSS Newsfeed' },
      { href: '/sitemap.xml', label: 'Site Index' },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="brand-link">
          <img class="footer-avatar" src="/mascot-avatar.png" alt="Capy mascot" width="50" height="50" />
          <div class="brand-info">
            <span class="brand-name">Capy<span class="royal">News</span></span>
            <span class="brand-sub">Independent Calm Journalism</span>
          </div>
        </a>
        <p class="brand-desc">
          Balancing critical global tech insights with the calming wisdom of our 3D furry capybara mascot. 
          Fact-checked, high-signal, and zero doomscrolling.
        </p>
        <div class="mascot-status-pill">
          <span class="paw">🐾</span>
          <span>Editor Capy is reading the morning wires</span>
        </div>
      </div>

      {
        cols.map((col) => (
          <nav class="footer-col" aria-label={col.title}>
            <h3 class="col-heading">{col.title}</h3>
            <ul class="col-links">
              {col.links.map((l) => (
                <li>
                  <a href={l.href} class="footer-link">{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="footer-bottom">
      <div class="bottom-left">
        <p>© {year} CapyNews Media Inc. High-End Editorial Template.</p>
        <p class="palette-indicator">
          Palette: <span class="swatch-tag" style="color:#C3D7FC">#C3D7FC</span> • 
          <span class="swatch-tag" style="color:#2875FB">#2875FB</span> • 
          <span class="swatch-tag" style="color:#8F5D38">#8F5D38</span> • 
          <span class="swatch-tag" style="color:#FFFFFF">#030E50</span>
        </p>
      </div>
      <div class="bottom-right">
        <span>Designed with precision • Dribbble & Behance Trending UI</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 80px;
    border-top: 2px solid var(--periwinkle);
    background: linear-gradient(180deg, #030E50 0%, #020726 100%);
    color: #FFFFFF;
    padding-block: 60px 32px;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: 40px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .footer-avatar {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    border: 2px solid var(--periwinkle);
    background: #FFFFFF;
  }

  .brand-name {
    font-size: 1.35rem;
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1.1;
  }

  .royal {
    color: var(--royal);
  }

  .brand-sub {
    display: block;
    font-size: 0.72rem;
    color: var(--periwinkle);
    letter-spacing: 0.04em;
  }

  .brand-desc {
    color: var(--periwinkle);
    font-size: 0.88rem;
    line-height: 1.6;
    max-width: 36ch;
    opacity: 0.9;
  }

  .mascot-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(195, 215, 252, 0.12);
    border: 1px solid rgba(195, 215, 252, 0.25);
    padding: 6px 12px;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    color: var(--periwinkle);
    width: fit-content;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .col-heading {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--periwinkle);
    font-weight: 800;
  }

  .col-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-link {
    font-size: 0.88rem;
    color: #DDE8FD;
    transition: color 0.15s var(--ease), transform 0.15s var(--ease);
    display: inline-block;
  }
  .footer-link:hover {
    color: var(--royal);
    transform: translateX(4px);
  }

  .footer-bottom {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid rgba(195, 215, 252, 0.2);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 0.8rem;
    color: var(--periwinkle);
    opacity: 0.85;
  }

  .swatch-tag {
    font-weight: 700;
  }

  @media (max-width: 960px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 580px) {
    .footer-top {
      grid-template-columns: 1fr;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
