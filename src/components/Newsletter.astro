---
/**
 * CapyNews Daily Dispatch Newsletter Block
 * Featuring Capy Mascot Sketch with Megaphone
 */
---

<section class="section" id="newsletter">
  <div class="container">
    <div class="newsletter-card">
      <div class="nl-content">
        <div class="nl-eyebrow">
          <span class="paw">🐾</span>
          <span>CAPY'S DAILY DISPATCH</span>
        </div>
        <h2 class="nl-title">The Calmest Five Minutes in Tech & Global News</h2>
        <p class="nl-desc">
          Every morning at 7:00 AM, Chief Editor Capy curates the 5 pivotal stories shaping our world. 
          Zero clickbait, zero hysteria—just verified reporting with thoughtful commentary.
        </p>

        <form class="nl-form" id="newsletter-form" novalidate>
          <div class="input-wrapper">
            <input
              type="email"
              id="nl-email"
              name="email"
              placeholder="Enter your email for the morning brief…"
              autocomplete="email"
              required
            />
            <button type="submit" class="btn btn-primary nl-btn">
              <span>Subscribe Free</span>
              <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor">
                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>
          </div>
          <p class="nl-msg" id="nl-msg" role="status" aria-live="polite"></p>
        </form>

        <div class="nl-perks">
          <div class="perk-item">
            <span class="check-icon">✓</span>
            <span>48,000+ Readers</span>
          </div>
          <div class="perk-item">
            <span class="check-icon">✓</span>
            <span>Zero Spam, Unsubscribe Anytime</span>
          </div>
          <div class="perk-item">
            <span class="check-icon">✓</span>
            <span>Free Weekend Longform</span>
          </div>
        </div>
      </div>

      <div class="nl-mascot-spotlight">
        <div class="mascot-sketch-card">
          <img 
            src="/mascot-sketch.png" 
            alt="Capybara mascot megaphone sketch" 
            class="mascot-sketch-img"
            width="220" 
            height="220"
          />
          <div class="mascot-speech">
            <span>"Only high-signal news, guaranteed!"</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .newsletter-card {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 40px;
    align-items: center;
    padding: clamp(32px, 5vw, 56px);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, #030E50 0%, #071960 60%, #030E50 100%);
    border: 1px solid var(--periwinkle);
    color: #FFFFFF;
    box-shadow: 0 20px 50px -10px rgba(3, 14, 80, 0.4);
    position: relative;
    overflow: hidden;
  }

  .newsletter-card::after {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(40, 117, 251, 0.25) 0%, transparent 70%);
    pointer-events: none;
  }

  .nl-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
    z-index: 2;
  }

  .nl-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--periwinkle);
  }

  .nl-title {
    font-family: var(--font-editorial);
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    font-weight: 700;
    line-height: 1.15;
    color: #FFFFFF;
  }

  .nl-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--periwinkle);
    max-width: 48ch;
  }

  .input-wrapper {
    display: flex;
    gap: 10px;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    padding: 6px;
    border-radius: var(--radius-full);
    border: 1px solid rgba(195, 215, 252, 0.3);
  }

  .input-wrapper input {
    flex: 1;
    border: none;
    background: transparent;
    padding: 10px 18px;
    color: #FFFFFF;
    font-size: 0.95rem;
  }
  .input-wrapper input::placeholder {
    color: rgba(195, 215, 252, 0.6);
  }
  .input-wrapper input:focus {
    outline: none;
  }

  .nl-btn {
    border-radius: var(--radius-full);
    padding: 10px 24px;
    font-weight: 800;
  }

  .nl-msg {
    font-size: 0.86rem;
    min-height: 1.2em;
    margin-top: 8px;
  }
  .nl-msg.ok {
    color: #34D399;
  }
  .nl-msg.err {
    color: #FF7B7B;
  }

  .nl-perks {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    font-size: 0.8rem;
    color: var(--periwinkle);
    margin-top: 6px;
  }
  .perk-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .check-icon {
    color: #34D399;
    font-weight: bold;
  }

  /* Mascot Spotlight */
  .nl-mascot-spotlight {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .mascot-sketch-card {
    background: #FFFFFF;
    padding: 24px;
    border-radius: var(--radius-lg);
    border: 2px solid var(--periwinkle);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    transform: rotate(2deg);
    transition: transform 0.25s var(--ease);
  }
  .mascot-sketch-card:hover {
    transform: rotate(0deg) scale(1.03);
  }

  .mascot-sketch-img {
    width: 200px;
    height: auto;
    object-fit: contain;
  }

  .mascot-speech {
    background: var(--periwinkle-light);
    color: var(--navy);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 700;
    border: 1px solid var(--periwinkle);
  }

  @media (max-width: 860px) {
    .newsletter-card {
      grid-template-columns: 1fr;
    }
    .input-wrapper {
      flex-direction: column;
      border-radius: var(--radius);
      padding: 10px;
    }
    .nl-btn {
      width: 100%;
    }
    .mascot-sketch-card {
      transform: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var form = document.getElementById('newsletter-form');
    if (!form) return;
    var input = document.getElementById('nl-email');
    var msg = document.getElementById('nl-msg');
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var value = (input.value || '').trim();
      var valid = /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(value);
      if (!valid) {
        msg.textContent = 'Please enter a valid email address.';
        msg.className = 'nl-msg err';
        input.focus();
        return;
      }
      msg.textContent = '🐾 Capy welcomes you aboard! Check your inbox to confirm.';
      msg.className = 'nl-msg ok';
      form.reset();
    });
  })();
</script>
