---
import Navigation from './Navigation.astro';
import ThemeToggle from './ThemeToggle.astro';

export interface Props {
  current?: string;
}
const { current } = Astro.props;

const todayDate = new Intl.DateTimeFormat('en-US', {
  weekday: 'long',
  month: 'short',
  day: 'numeric',
  year: 'numeric',
}).format(new Date());
---

<header class="site-header">
  <!-- Top Editorial Ticker Bar -->
  <div class="top-bar">
    <div class="container top-bar__inner">
      <div class="top-bar__left">
        <span class="date-badge">{todayDate}</span>
        <span class="divider-dot">•</span>
        <span class="edition-badge">CapyNews Global Editorial</span>
        <span class="divider-dot">•</span>
        <span class="chill-index">
          <span class="pulse-indicator"></span>
          Chill Index: <strong>98.4% Calm</strong>
        </span>
      </div>
      <div class="top-bar__right">
        <span class="mascot-tag">
          <span class="paw-icon">🐾</span> Fact-Checked by Mascot Capy
        </span>
        <a href="#newsletter" class="top-bar__link">Get Daily Dispatch</a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="container main-bar">
    <a href="/" class="brand-logo" aria-label="CapyNews Home">
      <div class="logo-avatar-frame">
        <img class="logo-avatar" src="/mascot-avatar.png" alt="Capy mascot" width="46" height="46" />
        <span class="online-dot" title="Capy is on editorial duty"></span>
      </div>
      <div class="brand-text">
        <span class="brand-title">Capy<span class="brand-accent">News</span></span>
        <span class="brand-tagline">Calm Journalism • Sharp Tech</span>
      </div>
    </a>

    <div class="nav-desktop">
      <Navigation current={current} />
    </div>

    <div class="actions">
      <a href="/search" class="icon-btn" aria-label="Search articles" title="Search">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
      </a>

      <ThemeToggle />

      <button
        type="button"
        class="icon-btn menu-btn"
        id="menu-btn"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile / Tablet Category Rail -->
  <div class="nav-scroll">
    <div class="container">
      <Navigation current={current} className="scroller" />
    </div>
  </div>
</header>

<div class="mobile-drawer" id="mobile-drawer" hidden>
  <div class="drawer-panel">
    <div class="drawer-head">
      <div class="drawer-brand">
        <img class="drawer-avatar" src="/mascot-avatar.png" alt="Capy mascot" width="40" height="40" />
        <div>
          <strong>CapyNews</strong>
          <small style="display:block;color:var(--text-muted);font-size:0.75rem;">Editorial Mobile Edition</small>
        </div>
      </div>
      <button type="button" class="icon-btn" id="drawer-close" aria-label="Close menu">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>

    <a href="/search" class="drawer-search">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" />
      </svg>
      <span>Search technology & global news…</span>
    </a>

    <div class="drawer-mascot-tip">
      <img src="/mascot-standing.png" alt="Capy mascot" width="56" height="56" style="border-radius:12px;object-fit:contain;background:#fff;border:1px solid var(--border);" />
      <div>
        <span style="font-weight:700;font-size:0.85rem;color:var(--royal);display:block;">Capy's Editorial Tip</span>
        <span style="font-size:0.8rem;color:var(--text-muted);">Stay curious, fact-check everything, and sip your tea. 🐾</span>
      </div>
    </div>

    <Navigation current={current} className="drawer" />
  </div>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--background) 92%, transparent);
    backdrop-filter: saturate(180%) blur(16px);
    border-bottom: 1px solid var(--border);
  }

  /* Top editorial bar */
  .top-bar {
    background: color-mix(in srgb, var(--periwinkle) 25%, var(--surface));
    border-bottom: 1px solid var(--border);
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 600;
  }
  .top-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--topbar-height);
    gap: 16px;
  }
  .top-bar__left,
  .top-bar__right {
    display: flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }
  .divider-dot {
    opacity: 0.4;
  }
  .chill-index {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text);
  }
  .top-bar__link {
    color: var(--royal);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .top-bar__link:hover {
    color: var(--royal-hover);
  }

  /* Main navigation bar */
  .main-bar {
    display: flex;
    align-items: center;
    gap: 24px;
    height: var(--header-height);
  }

  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }
  .logo-avatar-frame {
    position: relative;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--royal), var(--periwinkle));
    padding: 2px;
    box-shadow: 0 4px 12px rgba(40, 117, 251, 0.25);
    transition: transform 0.25s var(--ease);
  }
  .brand-logo:hover .logo-avatar-frame {
    transform: rotate(-4deg) scale(1.06);
  }
  .logo-avatar {
    width: 100%;
    height: 100%;
    border-radius: 12px;
    object-fit: cover;
    background: var(--surface);
  }
  .online-dot {
    position: absolute;
    bottom: -2px;
    right: -2px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #10B981;
    border: 2px solid var(--surface);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }
  .brand-title {
    font-family: var(--font-sans);
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text);
    line-height: 1.1;
  }
  .brand-accent {
    color: var(--royal);
  }
  .brand-tagline {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--capybara-brown);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .nav-desktop {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(90deg, #000 94%, transparent);
    mask-image: linear-gradient(90deg, #000 94%, transparent);
  }
  .nav-desktop::-webkit-scrollbar {
    display: none;
  }
  .nav-desktop :global(.site-nav ul) {
    flex-wrap: nowrap;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text);
    transition: all 0.18s var(--ease);
  }
  .icon-btn:hover {
    background: var(--periwinkle-light);
    border-color: var(--royal);
    color: var(--royal);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px var(--royal-glow);
  }
  .menu-btn {
    display: none;
  }
  .nav-scroll {
    display: none;
  }

  /* Responsive */
  @media (max-width: 1080px) {
    .top-bar__right {
      display: none;
    }
    .nav-desktop {
      display: none;
    }
    .menu-btn {
      display: inline-grid;
    }
    .nav-scroll {
      display: block;
      border-top: 1px solid var(--border);
      overflow-x: auto;
      scrollbar-width: none;
      background: var(--surface-2);
    }
    .nav-scroll::-webkit-scrollbar {
      display: none;
    }
    .nav-scroll :global(.site-nav ul) {
      flex-wrap: nowrap;
      padding-block: 8px;
    }
  }

  @media (max-width: 640px) {
    .top-bar {
      display: none;
    }
    .brand-tagline {
      display: none;
    }
  }

  /* Mobile Drawer */
  .mobile-drawer {
    position: fixed;
    inset: 0;
    z-index: 250;
    background: rgba(3, 14, 80, 0.6);
    backdrop-filter: blur(8px);
    display: flex;
    justify-content: flex-end;
  }
  .mobile-drawer[hidden] {
    display: none;
  }
  .drawer-panel {
    width: min(88vw, 360px);
    height: 100%;
    background: var(--surface);
    border-left: 1px solid var(--border-strong);
    padding: 24px 20px;
    overflow-y: auto;
    animation: slidein 0.22s var(--ease);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  @keyframes slidein {
    from {
      transform: translateX(30px);
      opacity: 0;
    }
  }
  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }
  .drawer-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .drawer-avatar {
    border-radius: 10px;
    border: 1px solid var(--royal);
  }
  .drawer-search {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 500;
  }
  .drawer-mascot-tip {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px;
    border-radius: var(--radius-sm);
    background: var(--periwinkle-light);
    border: 1px solid var(--periwinkle);
  }
</style>

<script is:inline>
  (function () {
    var openBtn = document.getElementById('menu-btn');
    var drawer = document.getElementById('mobile-drawer');
    var closeBtn = document.getElementById('drawer-close');
    if (!openBtn || !drawer) return;

    function open() {
      drawer.hidden = false;
      openBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }
    function close() {
      drawer.hidden = true;
      openBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }
    openBtn.addEventListener('click', open);
    closeBtn && closeBtn.addEventListener('click', close);
    drawer.addEventListener('click', function (e) {
      if (e.target === drawer) close();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !drawer.hidden) close();
    });
  })();
</script>
