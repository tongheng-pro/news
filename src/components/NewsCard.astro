---
import type { Article } from '../types/news';
import { categorySlug } from '../types/news';
import { timeAgo, readingTimeLabel } from '../lib/format';
import NewsImage from './NewsImage.astro';

export interface Props {
  article: Article;
  /** "default" | "wide" (horizontal) | "compact" (no image) */
  variant?: 'default' | 'wide' | 'compact';
  eager?: boolean;
}

const { article, variant = 'default', eager = false } = Astro.props;
const href = `/news/${article.slug}`;
---

<article class:list={['card', `card--${variant}`]}>
  {
    variant !== 'compact' && (
      <a href={href} class="card-media" tabindex="-1" aria-hidden="true">
        <NewsImage
          src={article.image}
          alt={article.title}
          seed={article.slug}
          eager={eager}
          sizes={variant === 'wide' ? '(max-width: 620px) 100vw, 40vw' : '(max-width: 620px) 100vw, 25vw'}
        />
      </a>
    )
  }
  <div class="card-body">
    <div class="card-meta">
      <a href={`/category/${categorySlug(article.category)}`} class="card-cat">{article.category}</a>
      <span class="dot" aria-hidden="true">·</span>
      <time datetime={article.publishedAt}>{timeAgo(article.publishedAt)}</time>
    </div>
    <h3 class="card-title">
      <a href={href}>{article.title}</a>
    </h3>
    {variant !== 'compact' && <p class="card-excerpt">{article.excerpt}</p>}
    <div class="card-foot">
      <span class="card-source">{article.source}</span>
      <span class="dot" aria-hidden="true">·</span>
      <span>{readingTimeLabel(article.readingTime)}</span>
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.18s var(--ease), border-color 0.18s var(--ease),
      box-shadow 0.18s var(--ease);
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }
  .card:hover :global(.img-frame img) {
    transform: scale(1.05);
  }
  .card-media {
    display: block;
  }
  .card-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px;
    flex: 1;
  }
  .card-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.74rem;
    color: var(--text-muted);
    font-weight: 600;
  }
  .card-cat {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .card-cat:hover {
    text-decoration: underline;
  }
  .card-title {
    font-size: 1.02rem;
    line-height: 1.32;
    letter-spacing: -0.01em;
  }
  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card-title a:hover {
    color: var(--accent);
  }
  .card {
    position: relative;
  }
  .card-excerpt {
    font-size: 0.88rem;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-foot {
    margin-top: auto;
    padding-top: 6px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.76rem;
    color: var(--text-muted);
  }
  .card-source {
    font-weight: 600;
    color: var(--text);
  }

  /* wide / horizontal */
  .card--wide {
    flex-direction: row;
  }
  .card--wide .card-media {
    flex: 0 0 42%;
  }
  .card--wide .card-media :global(.img-frame) {
    height: 100%;
    aspect-ratio: auto;
  }
  @media (max-width: 620px) {
    .card--wide {
      flex-direction: column;
    }
    .card--wide .card-media :global(.img-frame) {
      aspect-ratio: 16 / 9;
    }
  }

  /* compact / headline-only */
  .card--compact {
    border: none;
    border-radius: 0;
    background: transparent;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }
  .card--compact:hover {
    transform: none;
    box-shadow: none;
  }
  .card--compact .card-body {
    padding: 0;
  }
</style>
