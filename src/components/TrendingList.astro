---
import type { Article } from '../types/news';
import { timeAgo } from '../lib/format';

export interface Props {
  articles: Article[];
  title?: string;
  startAt?: number;
}
const { articles, title = 'Trending', startAt = 1 } = Astro.props;
---

<section class="trending">
  {title && <h2 class="trending-title">{title}</h2>}
  <ol style={`--start:${startAt}`}>
    {
      articles.map((a, i) => (
        <li>
          <span class="rank" aria-hidden="true">{String(startAt + i).padStart(2, '0')}</span>
          <div class="t-body">
            <a href={`/news/${a.slug}`}>{a.title}</a>
            <div class="t-meta">
              <span>{a.category}</span>
              <span class="dot" aria-hidden="true">·</span>
              <time datetime={a.publishedAt}>{timeAgo(a.publishedAt)}</time>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .trending-title {
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--text);
    margin-bottom: 4px;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: t;
  }
  li {
    display: flex;
    gap: 14px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }
  li:last-child {
    border-bottom: none;
  }
  .rank {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    line-height: 1.4;
    min-width: 1.8ch;
  }
  .t-body a {
    font-weight: 650;
    font-size: 0.95rem;
    line-height: 1.34;
    display: block;
  }
  .t-body a:hover {
    color: var(--accent);
  }
  .t-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 5px;
    font-size: 0.74rem;
    color: var(--text-muted);
  }
</style>
